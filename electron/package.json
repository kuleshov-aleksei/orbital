{
  "name": "orbital-desktop",
  "version": "1.0.0",
  "description": "The Orbital - Voice Chat Desktop App",
  "main": "dist-electron/main/index.js",
  "author": {
    "name": "Orbital Team",
    "email": "orbital@encamy.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/kuleshov-aleksei/orbital",
  "desktopName": "orbital",
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://localhost:3001"
    }
  },
  "scripts": {
    "dev": "VITE_DEV_SERVER_URL=http://localhost:3001 npx vite",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').cpSync('../frontend/dist','dist',{recursive:true})\"",
    "prebuild:venmic": "npx tsx scripts/copyVenmic.mts",
    "build": "npx tsx scripts/generate-licenses.js && npx vite build && npx tsx scripts/copyVenmic.mts && electron-builder --linux",
    "build:win": "npx tsx scripts/generate-licenses.js && npx vite build && npx tsx scripts/copyVenmic.mts && electron-builder --win",
    "build:linux": "npx tsx scripts/generate-licenses.js && npx vite build && npx tsx scripts/copyVenmic.mts && electron-builder --linux",
    "build:all": "npx tsx scripts/generate-licenses.js && npx vite build && npx tsx scripts/copyVenmic.mts && electron-builder -wl",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "chart.js": "^4.5.1",
    "chartjs-chart-sankey": "^0.15.0",
    "dompurify": "^3.4.13",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "livekit-client": "^2.21.0",
    "marked": "^18.0.7",
    "pinia": "^4.0.0",
    "pixi.js": "^8.19.0",
    "vue": "^3.5.40",
    "vue-advanced-cropper": "^2.8.9",
    "vue-boring-avatars": "^1.4.0",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0",
    "vue-virtual-scroller": "^3.0.4"
  },
  "optionalDependencies": {
    "@vencord/venmic": "^7.1.0"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/simple-icons": "^1.2.91",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.1.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-electron": "^1.0.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
