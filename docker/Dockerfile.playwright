# Playwright E2E test image
#
# Runs the frontend Playwright suite with the Go backend and LiveKit server
# started inside the same container, so no local browser/Playwright install is
# required. Build from the repository root:
#
#   docker build -t orbital-playwright-tests -f docker/Dockerfile.playwright .

FROM golang:1.27.3-alpine AS go

FROM livekit/livekit-server:v1.13.11 AS livekit

FROM mcr.microsoft.com/playwright:v1.64.1-noble

# The Go toolchain comes from the pinned golang image above. Keep it local so
# `go run` cannot try to download a different toolchain at test time.
ENV GOTOOLCHAIN=local
ENV PATH="/usr/local/go/bin:${PATH}"

# build-essential + libvips + libopus are required to build the backend (bimg, hraban/opus; CGO).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libvips-dev \
        libopus-dev \
        libopusfile-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY --from=go /usr/local/go /usr/local/go
COPY --from=livekit /livekit-server /usr/local/bin/livekit-server

RUN npm install -g pnpm@12.16.1

WORKDIR /app

# Install dependencies in their own layers so source-only changes stay cached.
# The pnpm store is a BuildKit cache mount; node_modules itself stays in the image.
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./frontend/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    cd frontend && pnpm install --frozen-lockfile --store-dir /pnpm/store

# Go modules must live in the image (tests `go run` the backend at runtime),
# so no cache mount here; copying go.mod/go.sum first keeps this layer cached
# across source changes.
COPY backend/go.mod backend/go.sum ./backend/
RUN cd backend && go mod download

COPY frontend/ ./frontend/
COPY backend/ ./backend/
COPY tools/ ./tools/
COPY livekit/ ./livekit/

WORKDIR /app/backend

# Pre-compile the backend into the image's Go build cache so Playwright's
# `go run ./cmd/server` starts in seconds instead of compiling the CGO
# dependencies (libvips, opus) on every test run.
RUN CGO_ENABLED=1 go build -o /dev/null ./cmd/server

RUN mkdir -p /app/backend/data

COPY docker/playwright-entrypoint.sh /usr/local/bin/playwright-entrypoint.sh
RUN chmod +x /usr/local/bin/playwright-entrypoint.sh

WORKDIR /app/frontend

ENTRYPOINT ["/usr/local/bin/playwright-entrypoint.sh"]
