# Stage 0: Windows per-app audio helper (native/win-audiocap, Rust), shipped
# by electron-builder through win.extraResources. Its own stage, so it stays
# cached and the Node image needs no Rust toolchain.
FROM rust:1.100-trixie AS audiocap
RUN rustup target add x86_64-pc-windows-gnu && \
    apt-get update && \
    apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 make && \
    rm -rf /var/lib/apt/lists/*
COPY native/win-audiocap/ /src/native/win-audiocap/
RUN make -C /src/native/win-audiocap

# Stage 1: Build environment. This stage is source-independent — CI prewarms it
# with `docker build --target deps` (docs/notes/build-cache-prewarm.md).
FROM node:26.13.0-trixie AS deps

# System dependencies (rarely changes — cached layer)
RUN npm install -g pnpm@12.18.0

RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    wine \
    wine32:i386 \
    git \
    python3 \
    make \
    automake \
    g++ \
    cmake \
    ninja-build \
    libsecret-1-dev \
    libpipewire-0.3-dev \
    libpulse-dev \
    libstdc++-12-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ── Source-independent layers ──
# Nothing in this section may read commit-specific files: it has to stay valid
# across commits. Only rarely-changing inputs — the lockfiles and the license
# generator script — are allowed here. CI prewarms exactly this with
# `--target deps` (docs/notes/build-cache-prewarm.md), so a release inherits it
# instead of re-downloading toolchains on release night.
#
# Both dependency sets are installed before any source is copied, so editing
# frontend/ or electron/ never re-runs an install.
WORKDIR /app/frontend
COPY frontend/package.json ./
COPY frontend/pnpm-*.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

WORKDIR /app/electron
COPY electron/package.json ./
COPY electron/pnpm-*.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

# Third-party license list: it queries the registry once per dependency, so it
# lives here and only re-runs when package.json or the script changes.
COPY electron/scripts/ ./scripts/
RUN node scripts/generate-licenses.js

# Prewarm boundary. `docker build --target deps` stops here; everything below
# depends on the repo's source and runs on every release.
FROM deps AS release-build

# ── Source-dependent layers ──
WORKDIR /app/frontend

# Frontend source (cached until source files change).
COPY frontend/ .

# Release quality gate: fail the build on type errors
RUN pnpm run typecheck

WORKDIR /app/electron

# Electron source (+ shell API version and the OTA bundle generator)
COPY electron/ .
COPY shell-api.json /app/shell-api.json
COPY scripts/ota-manifest.mjs /app/scripts/ota-manifest.mjs

# Release quality gate: main/preload type errors fail the build too
RUN pnpm run typecheck

# Windows per-app audio helper, built in the audiocap stage.
COPY --from=audiocap /src/native/win-audiocap/orbital-audiocap.exe /app/native/win-audiocap/orbital-audiocap.exe

# ── Version-sensitive section ──
# Everything below invalidates every release (unavoidable for builds)
ARG VERSION=dev-unknown
ARG VITE_BACKEND_URL=
# Public update feed baked into resources/app-update.yml (S3 website endpoint).
# Overridden in CI from the UPDATE_URL secret.
ARG UPDATE_URL=https://orbital-updates.encamy.com/
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_APP_VERSION=$VERSION
ENV UPDATE_URL=$UPDATE_URL

WORKDIR /app/electron
RUN sed -i "s/\"version\": \".*\"/\"version\": \"$VERSION\"/" package.json

# Bundle renderer (frontend) + main + preload once; both installers package
# the same dist/ and dist-electron/. (build:win/build:linux would each redo
# the licenses and the vite build.)
RUN pnpm exec vite build

# Package Windows, then Linux, with cache mounts for electron/electron-builder
# downloads
RUN --mount=type=cache,target=/root/.cache/electron,sharing=locked \
    --mount=type=cache,target=/root/.cache/electron-builder,sharing=locked \
    pnpm run package:win

RUN --mount=type=cache,target=/root/.cache/electron,sharing=locked \
    --mount=type=cache,target=/root/.cache/electron-builder,sharing=locked \
    pnpm run package:linux

# Over-the-air frontend bundle (electron/main/features/ota.ts): manifest +
# content-addressed files, uploaded next to the installers by CI.
RUN node /app/scripts/ota-manifest.mjs dist electron "$VERSION" "$VITE_BACKEND_URL" release/ota

# Stage 2: Minimal image with only release artifacts
FROM alpine:3.24
RUN apk add --no-cache ca-certificates
WORKDIR /app/electron
COPY --from=release-build /app/electron/release ./release
