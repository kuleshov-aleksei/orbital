# Stage 1: Build environment
FROM node:26.12.1-trixie AS builder

# System dependencies (rarely changes — cached layer)
RUN npm install -g pnpm@12.16.1

RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    wine \
    wine32:i386 \
    git \
    python3 \
    make \
    automake \
    g++ \
    cmake \
    ninja-build \
    libsecret-1-dev \
    libpipewire-0.3-dev \
    libpulse-dev \
    libstdc++-12-dev \
    g++-mingw-w64-x86-64 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/frontend

# Frontend dependencies (cached when lockfile unchanged)
COPY frontend/package.json ./
COPY frontend/pnpm-*.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

# Frontend source (cached until source files change).
# tools/halloween-balance is imported by the dev-only balance visualizer,
# which vue-tsc checks too
COPY tools/halloween-balance/ /app/tools/halloween-balance/
COPY frontend/ .

# Release quality gate: fail the build on type errors
RUN pnpm run typecheck

WORKDIR /app/electron

# Electron dependencies (cached when lockfile unchanged)
COPY electron/package.json ./
COPY electron/pnpm-*.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

# Electron source
COPY electron/ .

# Generate licenses
RUN node scripts/generate-licenses.js

# Windows per-app audio helper (native/win-audiocap), shipped by
# electron-builder through win.extraResources.
# Built before the version-sensitive section so it stays cached.
COPY native/win-audiocap/ /app/native/win-audiocap/
RUN make -C /app/native/win-audiocap

# ── Version-sensitive section ──
# Everything below invalidates every release (unavoidable for builds)
ARG VERSION=dev-unknown
ARG VITE_BACKEND_URL=
# Public update feed baked into resources/app-update.yml (S3 website endpoint).
# Overridden in CI from the UPDATE_URL secret.
ARG UPDATE_URL=https://orbital-updates.encamy.com/
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_APP_VERSION=$VERSION
ENV UPDATE_URL=$UPDATE_URL

WORKDIR /app/electron
RUN sed -i "s/\"version\": \".*\"/\"version\": \"$VERSION\"/" package.json

# Bundle renderer (frontend) + main + preload once; both installers package
# the same dist/ and dist-electron/. (build:win/build:linux would each redo
# the licenses and the vite build.)
RUN pnpm exec vite build

# Package Windows, then Linux, with cache mounts for electron/electron-builder
# downloads
RUN --mount=type=cache,target=/root/.cache/electron,sharing=locked \
    --mount=type=cache,target=/root/.cache/electron-builder,sharing=locked \
    pnpm run package:win

RUN --mount=type=cache,target=/root/.cache/electron,sharing=locked \
    --mount=type=cache,target=/root/.cache/electron-builder,sharing=locked \
    pnpm run package:linux

# Stage 2: Minimal image with only release artifacts
FROM alpine:3.24
RUN apk add --no-cache ca-certificates
WORKDIR /app/electron
COPY --from=builder /app/electron/release ./release
