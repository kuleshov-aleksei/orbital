# Frontend Dockerfile
FROM node:26.13.0-alpine AS builder

# Mirror the repo layout (/app/frontend + /app/tools): the dev-only balance
# visualizer imports from tools/halloween-balance, and vue-tsc checks it too
WORKDIR /app/frontend
COPY frontend/package.json ./
COPY frontend/pnpm-*.yaml ./
RUN npm install -g pnpm@12.16.1
# The store lives in a BuildKit cache mount so lockfile changes only download
# the packages that changed.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

COPY tools/halloween-balance/ /app/tools/halloween-balance/
COPY frontend/ .
# Release quality gate: fail the image build on type errors
RUN pnpm run typecheck
RUN pnpm run generate:licenses

# Declared as late as possible: VERSION changes every release, and every RUN
# after an ARG misses the cache when its value changes.
ARG VERSION=dev-unknown
ARG APP_URL=http://localhost:8000
ENV VITE_APP_VERSION=${VERSION}
ENV VITE_APP_URL=${APP_URL}
RUN pnpm run build

FROM alpine:3.24

RUN apk add --no-cache nginx nginx-mod-http-brotli

COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/nginx.conf

EXPOSE 8000
# Let nginx drain in-flight requests on `docker stop`.
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
