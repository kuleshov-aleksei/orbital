# Backend Dockerfile
FROM golang:1.27-alpine AS builder

# Install build dependencies for libvips, libopus (soundboard encoding) and CGO
RUN apk add --no-cache \
    build-base \
    vips-dev \
    opus-dev \
    opusfile-dev \
    pkgconfig

WORKDIR /app
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# Release quality gate: fail the image build on lint errors.
# Keep the version in sync with the golangci-lint used locally for `make lint`
COPY --from=golangci/golangci-lint:v2.15.0-alpine /usr/bin/golangci-lint /usr/bin/golangci-lint

COPY backend/ .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache \
    CGO_ENABLED=1 golangci-lint run

# Declared right before its only use: VERSION changes every release, and every
# RUN after an ARG misses the cache when its value changes.
ARG VERSION=dev-unknown
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache \
    CGO_ENABLED=1 GOOS=linux go build -ldflags "-X github.com/kuleshov-aleksei/orbital/internal/version.Version=${VERSION}" -o orbital ./cmd/server

FROM alpine:3.24

# Install runtime dependencies (libvips, libopus and ca-certificates)
RUN apk --no-cache add \
    ca-certificates \
    vips \
    opus \
    opusfile

WORKDIR /root/

# Create data directories for uploads (avatars, audio, halloween art)
RUN mkdir -p /root/data/avatars /root/data/audio /root/data/halloween

COPY --from=builder /app/orbital .
COPY --from=builder /app/assets ./assets

EXPOSE 8080
CMD ["./orbital"]