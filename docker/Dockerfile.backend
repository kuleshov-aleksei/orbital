# Backend Dockerfile
FROM golang:1.27-alpine AS builder

# Install build dependencies for libvips and CGO
RUN apk add --no-cache \
    build-base \
    vips-dev \
    pkgconfig

# Accept version as build argument
ARG VERSION=dev-unknown

WORKDIR /app
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# Release quality gate: fail the image build on lint errors.
# Keep the version in sync with the golangci-lint used locally for `make lint`
COPY --from=golangci/golangci-lint:v2.14.0-alpine /usr/bin/golangci-lint /usr/bin/golangci-lint

COPY backend/ .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache \
    CGO_ENABLED=1 golangci-lint run
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache \
    CGO_ENABLED=1 GOOS=linux go build -ldflags "-X github.com/kuleshov-aleksei/orbital/internal/version.Version=${VERSION}" -o orbital ./cmd/server

FROM alpine:latest

# Install runtime dependencies (libvips and ca-certificates)
RUN apk --no-cache add \
    ca-certificates \
    vips

WORKDIR /root/

# Create data directories for uploads (avatars, audio, halloween art)
RUN mkdir -p /root/data/avatars /root/data/audio /root/data/halloween

COPY --from=builder /app/orbital .
COPY --from=builder /app/assets ./assets

EXPOSE 8080
CMD ["./orbital"]