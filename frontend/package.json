{
  "name": "orbital-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "generate:licenses": "node scripts/generate-licenses.js",
    "convert:soundsprite": "node scripts/convert-soundsprite.js",
    "lint": "(git diff --name-only HEAD; git ls-files --others --exclude-standard --full-name) | grep '^frontend/' | sed 's|^frontend/||' | grep -E '\\.(ts|vue|js|tsx|jsx)$' | sort -u | while read -r f; do [ -f \"$f\" ] && printf '%s\\n' \"$f\"; done | xargs -r eslint --config eslint.config.js --no-warn-ignored --fix",
    "lint:full": "eslint --config eslint.config.js src/ --fix",
    "prettier": "npx prettier . --write src/",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --grep-invert @screenshot",
    "test:e2e:screenshots": "playwright test --grep @screenshot",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --grep-invert @screenshot",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@phosphor-icons/vue": "^2.2.1",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@vueuse/sound": "^2.1.3",
    "chart.js": "^4.6.1",
    "chartjs-chart-sankey": "^0.19.1",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "howler": "^2.2.4",
    "libsodium-wrappers": "^0.8.4",
    "livekit-client": "^2.24.1",
    "marked": "^18.2.0",
    "pinia": "^4.1.0",
    "pixi.js": "^8.23.0",
    "qr": "^0.7.2",
    "vue": "^3.5.45",
    "vue-advanced-cropper": "^2.8.9",
    "vue-boring-avatars": "^1.4.0",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.5.1",
    "vue-virtual-scroller": "^3.0.5",
    "wavesurfer.js": "^8.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@iconify-json/logos": "^1.2.20",
    "@iconify-json/simple-icons": "^1.2.102",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/webrtc": "^0.0.47",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.8",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
