# Orbital Environment Configuration
# Copy this file to .env and customize values for your setup
# This is the unified configuration file for all Orbital components

# =============================================================================
# === ORBITAL BACKEND =========================================================
# =============================================================================

# Server port (default: 8080)
SERVER_PORT=8080

# Server mode: 'development' or 'production'
# Use 'production' for production
SERVER_MODE=development

# CORS and WebSocket allowed origins (comma-separated)
# Use '*' for development, specific domains for production
SERVER_CORS_ORIGINS=*

# External URL - where to redirect users after OAuth authentication
# This should be your frontend application URL
EXTERNAL_URL=http://localhost:8080

# Electron Redirect URL - deep link URL for Electron OAuth callback
# When OAuth completes in external browser, redirect to this URL to open Orbital
ELECTRON_REDIRECT_URL=orbital://auth/callback

# Public update feed root (Garage S3) serving desktop artifacts and latest.yml
# Used to resolve the newest desktop release for the download page
RELEASES_URL=https://orbital-updates.encamy.com

# =============================================================================
# === LIVEKIT SERVER ==========================================================
# =============================================================================

# LiveKit server WebSocket URL
# For Docker Compose deployment (internal communication between services):
LIVEKIT_URL=ws://livekit:7880

# For local development (outside Docker):
# LIVEKIT_URL=ws://localhost:7880

# For production with HTTPS (via Traefik with path-based routing):
# LIVEKIT_URL=wss://your-domain.com/livekit

# LiveKit API credentials for generating access tokens
# These must match the keys configured in livekit/livekit.yaml or livekit/livekit-dev.yaml
# IMPORTANT: Change these to secure values in production!
LIVEKIT_API_KEY=dev_key
LIVEKIT_API_SECRET=this_is_a_development_secret_key_32chars

# In production, generate strong secrets with:
# openssl rand -base64 32

# LiveKit external IP (if server is behind NAT)
# Uncomment and set for production deployments
# LIVEKIT_EXTERNAL_IP=your.public.ip.address

# =============================================================================
# === TEXT CHANNELS (MEILISEARCH) =============================================
# =============================================================================

# Text channel messages live in Meilisearch (docs/specs/CHAT_SYSTEM.md).
# Development defaults match docker-compose.dev.yml, so these can stay commented.
# Production (docker/docker-compose.deploy.yml) REQUIRES MEILI_MASTER_KEY
# (at least 16 bytes): openssl rand -base64 32
# MEILI_MASTER_KEY=orbital-dev-meili-key
# MEILI_URL=http://localhost:7700
# Optional scoped key for the backend (defaults to MEILI_MASTER_KEY)
# MEILI_API_KEY=
# MEILI_INDEX=text_messages

# =============================================================================
# === CHAT ATTACHMENTS (GARAGE S3) ============================================
# =============================================================================

# Development: `make garage-up` starts Garage from docker-compose.dev.yml and,
# on first start, creates this key and bucket. All three secrets are REQUIRED
# for the dev container. The backend uses the same key in development.
# Changing the key later adds a new key; remove the old one with
#   docker exec orbital-garage /garage key delete --yes <old key id>
# Access key id: "GK" + 24 hex chars:  echo "GK$(openssl rand -hex 12)"
GARAGE_DEFAULT_ACCESS_KEY=
# Secret key (64 hex chars):          openssl rand -hex 32
GARAGE_DEFAULT_SECRET_KEY=
# RPC secret between Garage nodes:     openssl rand -hex 32
GARAGE_RPC_SECRET=
# GARAGE_DEFAULT_BUCKET=orbital-chat-media

# Production uses an external Garage: create the bucket and a read/write key
# there and set these for the backend (docs/specs/CHAT_SYSTEM.md §11).
# CHAT_MEDIA_S3_ENDPOINT=http://garage:3900
# CHAT_MEDIA_S3_PUBLIC_ENDPOINT=https://s3.example.com
# CHAT_MEDIA_S3_BUCKET=orbital-chat-media
# CHAT_MEDIA_S3_REGION=garage
# CHAT_MEDIA_S3_ACCESS_KEY=
# CHAT_MEDIA_S3_SECRET_KEY=

# Search by image contents (OCR + CLIP, docs/specs/CHAT_SYSTEM.md §7.13): the
# URL of an Immich machine-learning service (port 3003). It must be reachable
# from the backend container and must not be exposed publicly. Dev: `make ml-up`.
# Needs chat attachments (CHAT_MEDIA_S3_*). Unset = disabled.
# CHAT_ML_URL=http://immich-machine-learning:3003
# CHAT_ML_OCR_ENABLED=true
# CHAT_ML_CLIP_ENABLED=true
# East Slavic recognition (ru/be/uk + en). Plain PP-OCRv5_mobile reads Cyrillic as Latin look-alikes.
# CHAT_ML_OCR_MODEL=ESLAV__PP-OCRv5_mobile
# Must embed search text in the users' languages; changing it re-indexes all images.
# CHAT_ML_CLIP_MODEL=XLM-Roberta-Large-Vit-B-16Plus
# Minimum score (0..1) of images found by meaning only; raise it if search
# shows unrelated images, lower it if relevant ones are missed.
# CHAT_ML_SEMANTIC_THRESHOLD=0.6
# CHAT_ML_TIMEOUT_SECONDS=120

# =============================================================================
# === ORBITAL ROOM SETTINGS ===================================================
# =============================================================================

# Minimum users per room
ROOM_MIN_USERS=2

# Maximum users per room
ROOM_MAX_USERS=10

# Default max users for new rooms
ROOM_DEFAULT_MAX_USERS=10

# =============================================================================
# === ORBITAL WEBSOCKET =======================================================
# =============================================================================

# Ping timeout - time without ping before disconnecting a user (default: 30s)
# This allows users to reconnect within this window without being removed from rooms
WS_PING_TIMEOUT=30s

# How often to check for ping timeouts (default: 10s)
WS_PING_CHECK_INTERVAL=10s

# =============================================================================
# === ORBITAL SECURITY ========================================================
# =============================================================================

# JWT Secret - CHANGE THIS TO A SECURE RANDOM STRING IN PRODUCTION!
# Used to sign and verify JWT tokens
JWT_SECRET=change-this-in-production

# Rate limits (per client IP, except debug-log uploads which are per user)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GUEST_PER_HOUR=10
RATE_LIMIT_OAUTH_PER_MINUTE=20
RATE_LIMIT_GUEST_UPLOAD_PER_HOUR=5
RATE_LIMIT_USER_UPLOAD_PER_HOUR=20
RATE_LIMIT_DEBUG_LOG_PER_MINUTE=1
RATE_LIMIT_QR_CHALLENGE_PER_MINUTE=10
RATE_LIMIT_QR_APPROVE_PER_MINUTE=30

# Per-user upload storage quotas
RATE_LIMIT_AUDIO_QUOTA_MB=512
RATE_LIMIT_DEBUG_LOG_QUOTA_MB=100

# Custom emoji library size cap (clients load it page by page)
EMOJI_MAX_CUSTOM=2000

# =============================================================================
# === OAUTH & AUTHENTICATION ==================================================
# =============================================================================

# Discord OAuth Configuration
# Create an application at: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URL=http://localhost:3000/api/auth/discord/callback
DISCORD_ELECTRON_REDIRECT_URL=http://localhost:3000/api/auth/discord/electron/callback

# Google OAuth Configuration
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_ELECTRON_REDIRECT_URL=http://localhost:3000/api/auth/google/electron/callback

# =============================================================================
# === ORBITAL LOGGING =========================================================
# =============================================================================

# Log level: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

# =============================================================================
# === ORBITAL FEATURE FLAGS ===================================================
# =============================================================================

# Enable WebRTC debug dashboard
ENABLE_DEBUG_DASHBOARD=true

# Enable screen sharing
ENABLE_SCREEN_SHARE=true

# =============================================================================
# === ORBITAL PRODUCTION SETTINGS (uncomment for production) ==================
# =============================================================================

# TLS certificate path
# TLS_CERT_PATH=/path/to/cert.pem

# TLS private key path  
# TLS_KEY_PATH=/path/to/key.pem

# External IP (if server is behind NAT)
# EXTERNAL_IP=your.public.ip.address
