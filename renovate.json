{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "minimumReleaseAge": "7 days",
  "schedule": ["* * * * 5,6"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "!/^7\\.0\\./"
    },
    {
      "description": "pion/rtp v2.0.0 is an abandoned 2020 tag; upstream (and pion/webrtc v4) stay on v1",
      "matchPackageNames": ["github.com/pion/rtp", "github.com/pion/rtp/v2"],
      "allowedVersions": "<2"
    },
    {
      "matchPackageNames": ["**"],
      "groupName": "all-dependencies",
      "automerge": false,
      "internalChecksFilter": "strict"
    },
    {
      "description": "Base images: majors only, so minor/patch bumps don't invalidate the Docker build cache",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["node", "golang", "alpine"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "enabled": false
    },
    {
      "description": "pnpm (CI + Dockerfiles): majors only, so all pins move together and the Docker cache isn't busted weekly",
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "pnpm pin in Dockerfiles (`npm install -g pnpm@x.y.z`), kept in step with pnpm/action-setup in CI",
      "managerFilePatterns": ["/(^|/)Dockerfile(\\.[^/]*)?$/"],
      "matchStrings": ["npm install -g pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "ignorePaths": [
    ".github/workflows/build-electron.yml",
    ".github/workflows/deploy.yml"
  ],
  "rangeStrategy": "bump"
}
